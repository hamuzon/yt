
{
  "name": "yt",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "previews": {},
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/go",
      "/go/*",
      "/yt/go",
      "/yt/go/*"
    ]
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
